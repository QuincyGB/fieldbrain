# FieldBrain configuration — copy to .env and fill in. Never commit a real .env.

# --- Answer generation (OpenAI-compatible chat completions) ---
# Leave blank for offline DEMO MODE (extractive answers from retrieved chunks).
# For the Evolus track build, point this at our own vLLM endpoint on
# AMD Developer Cloud (ROCm), e.g. http://<amd-instance>:8001/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Evolus building blocks (REST) ---
# Set USE_EVOLUS=true once the free event workspace exists (event code at kickoff).
USE_EVOLUS=false
EVOLUS_BASE_URL=
EVOLUS_API_KEY=
EVOLUS_KB_ID=
EVOLUS_WORKFLOW_ID=

# --- Retrieval / hand-off ---
# Confidence gate: the top chunk must clear this BM25 score AND the retrieved
# chunks must cover at least 60% of the question's IDF-weighted terms,
# otherwise the question is escalated to a human. 2.5 is tuned for the
# bundled seed corpus.
HANDOFF_THRESHOLD=2.5
TOP_K=6
